# Variables del entorno de Docker Compose (base de datos local).
# Este archivo SÍ se versiona: es la plantilla. Cópialo a `.env` y ajusta valores:
#   cp .env.example .env
#
# El `.env` real está gitignored: ahí van los valores de verdad, nunca aquí.
# Para un secreto de producción, aquí iría un placeholder (p. ej. "cambia-esto"),
# nunca el valor real. Esta base es local y desechable, así que el ejemplo alcanza.

# --- Frontend (Vite): la app apunta al backend local. Las VITE_* son públicas. ---
VITE_API_URL=http://localhost:3000/api
VITE_GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
VITE_BRANDFETCH_CLIENT_ID=tu-brandfetch-client-id

# --- Docker Compose (Postgres local): credenciales del contenedor de la base. ---
POSTGRES_USER=sumarket
POSTGRES_PASSWORD=sumamarketaexpresS # ejemplo de contraseña, cámbiala en tu `.env` real
POSTGRES_DB=sumarket_express
