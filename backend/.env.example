# Copia este archivo como .env y completa solo valores locales.
# No guardar secretos reales en este archivo.
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Reemplaza <usuario_local> por tu usuario de macOS/PostgreSQL.
DATABASE_URL="postgresql://<usuario_local>@localhost:5432/sumarket_express?schema=public"

# Se usan exclusivamente al ejecutar `npm run admin:create` en tu equipo.
# Déjalas con valores reales solo en .env; este archivo no lleva secretos.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary: credenciales exclusivas del backend para subir y borrar imágenes.
# No copies API_SECRET al frontend ni la subas a Git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
