# Copia este archivo como .env y completa solo valores locales.
# No guardar secretos reales en este archivo.
PORT=3000
# Origen del frontend permitido por CORS. En producción, la URL de Cloudflare
# Pages (ej. https://sumarketexpress.pages.dev), sin la ruta.
FRONTEND_ORIGIN=http://localhost:5173
# URL pública completa de la app. En Cloudflare Pages coincide con FRONTEND_ORIGIN
# (la app se sirve desde la raíz, sin subpath).
FRONTEND_APP_URL=http://localhost:5173
# En producción detrás de un proxy (Render), pon NODE_ENV=production: activa
# `trust proxy` y las cookies Secure.
NODE_ENV=
# Ponlo en "true" cuando el frontend y la API estén en dominios distintos
# (Cloudflare Pages + Render): las cookies de sesión pasan a SameSite=None; Secure.
COOKIE_CROSS_SITE=
# Reemplaza <usuario_local> por tu usuario de macOS/PostgreSQL.
DATABASE_URL="postgresql://<usuario_local>@localhost:5432/sumarket_express?schema=public"

# Se usan exclusivamente al ejecutar `npm run admin:create` en tu equipo.
# Déjalas con valores reales solo en .env; este archivo no lleva secretos.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary: credenciales exclusivas del backend para subir y borrar imágenes.
# No copies API_SECRET al frontend ni la subas a Git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago. Si MP_ACCESS_TOKEN está presente se usa la pasarela real; si no,
# una pasarela falsa para desarrollo. El Access Token es del backend (secreto);
# la Public Key es para el SDK del frontend. Usa credenciales de PRUEBA.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# URL pública a la que MP envía el webhook (en local, la del túnel ngrok +
# /api/pagos/webhook). Sin esto, MP no notifica.
MP_WEBHOOK_URL=

# Minutos tras los que un pedido PENDIENTE sin pagar se expira y libera su
# reserva de stock (opcional; por defecto 1440 = 24 h).
MINUTOS_EXPIRACION_PENDIENTE=

# Cada cuántos minutos el server corre el barrido que expira esos pedidos
# (opcional; por defecto 30). El barrido vive dentro del proceso del backend,
# no necesita cron externo.
MINUTOS_BARRIDO_EXPIRACION=

# Correo. Si BREVO_API_KEY está presente, los correos se envían de verdad por la
# API transaccional de Brevo; si no, van a la consola (dev). La API key es del
# backend (secreto). El remitente debe estar verificado en Brevo.
BREVO_API_KEY=
# Remitente de los correos, formato "Nombre <correo@dominio>" (opcional; por
# defecto SumarketExpress <no-responder@sumarketexpress.cl>).
CORREO_REMITENTE=

# Login con Google (clientes). El Client ID de OAuth de Google Cloud (es público;
# el frontend usa el mismo valor como VITE_GOOGLE_CLIENT_ID). El backend lo usa
# como "audience" para verificar el ID token. Sin él, POST /api/cuenta/google falla.
GOOGLE_CLIENT_ID=
