// Esquema de persistencia del catálogo. Las migraciones convertirán este
// contrato en tablas PostgreSQL; el frontend nunca consulta estas tablas directo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// El rol se guarda junto al usuario; nunca debe confiarse en un valor enviado
// por el navegador al solicitar una acción administrativa.
enum RolUsuario {
  ADMIN
  OPERADOR
}

// El estado editorial evita confundir un borrador con una baja lógica. Solo
// PUBLICADO se expone en la tienda; ARCHIVADO se conserva para trazabilidad.
enum EstadoProducto {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

// Las facetas configurables usan opciones (p. ej. Intensidad → Suave, Media,
// Intensa). BOOLEAN se representa también con opciones para conservar un único
// contrato de filtro y evitar campos especiales en Producto.
enum TipoAtributoCatalogo {
  SELECCION
  BOOLEAN
}

// La modalidad se decide una vez por pedido y define si se necesita dirección
// y si hay costo de envío (RETIRO siempre es gratis).
enum ModalidadEntrega {
  RETIRO
  DESPACHO
}

// Ciclo operativo del pedido. Las transiciones válidas se controlan en el
// servicio; el enum solo enumera los estados posibles. RETIRO y DESPACHO
// comparten inicio y fin pero difieren en el estado intermedio (LISTO_PARA_RETIRO
// vs ENVIADO).
enum EstadoPedido {
  PENDIENTE
  PREPARANDO
  LISTO_PARA_RETIRO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Por qué cambió el stock a mano (los movimientos automáticos de venta/reserva
// no pasan por aquí). ENTRADA suma (recepción de mercadería), MERMA resta
// (pérdida/daño/vencimiento) y CONTEO corrige contra un conteo físico (± ).
enum MotivoMovimientoStock {
  ENTRADA
  MERMA
  CONTEO
}

model Usuario {
  id                 String              @id @default(uuid()) @db.Uuid
  nombre             String              @db.VarChar(120)
  email              String              @unique @db.VarChar(255)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  rol                RolUsuario          @default(OPERADOR)
  activo             Boolean             @default(true)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  sesiones           Sesion[]
  tokensRecuperacion TokenRecuperacion[]
  movimientosStock   MovimientoStock[]

  @@index([activo])
  @@map("usuarios")
}

// La base nunca conserva el token que viaja al navegador, solo su hash. Esto
// permite expirar o revocar sesiones sin guardar credenciales reutilizables.
model Sesion {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiraEn   DateTime  @map("expira_en")
  revocadaEn DateTime? @map("revocada_en")
  createdAt  DateTime  @default(now()) @map("created_at")
  usuarioId  String    @map("usuario_id") @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("sesiones")
}

model Categoria {
  id            String              @id @default(uuid()) @db.Uuid
  nombre        String              @unique @db.VarChar(100)
  slug          String              @unique @db.VarChar(120)
  activa        Boolean             @default(true)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  productos     Producto[]
  subcategorias Subcategoria[]
  atributos     AtributoCategoria[]

  @@map("categorias")
}

// Define qué filtros se muestran en cada categoría. No se codifican nombres
// como "Intensidad" en React: café y limpieza pueden tener estructuras propias.
model AtributoCategoria {
  id          String               @id @default(uuid()) @db.Uuid
  nombre      String               @db.VarChar(80)
  slug        String               @unique @db.VarChar(120)
  tipo        TipoAtributoCatalogo @default(SELECCION)
  categoriaId String               @map("categoria_id") @db.Uuid
  categoria   Categoria            @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  orden       Int                  @default(0)
  activo      Boolean              @default(true)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  opciones    OpcionAtributo[]
  valores     ProductoAtributo[]

  @@unique([categoriaId, nombre])
  @@index([categoriaId, orden])
  @@map("atributos_categoria")
}

model OpcionAtributo {
  id         String             @id @default(uuid()) @db.Uuid
  nombre     String             @db.VarChar(80)
  slug       String             @unique @db.VarChar(140)
  atributoId String             @map("atributo_id") @db.Uuid
  atributo   AtributoCategoria  @relation(fields: [atributoId], references: [id], onDelete: Cascade)
  orden      Int                @default(0)
  activa     Boolean            @default(true)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  valores    ProductoAtributo[]

  @@unique([atributoId, nombre])
  @@index([atributoId, orden])
  @@map("opciones_atributo")
}

// Segundo nivel de la taxonomía (Despensa → Café y Cafeteras). El slug es único
// global (URL estable); el nombre es único dentro de su categoría.
model Subcategoria {
  id                 String             @id @default(uuid()) @db.Uuid
  nombre             String             @db.VarChar(100)
  slug               String             @unique @db.VarChar(120)
  categoriaId        String             @map("categoria_id") @db.Uuid
  categoria          Categoria          @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  orden              Int                @default(0)
  activa             Boolean            @default(true)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  productos          Producto[]
  subcategoriasHijas SubcategoriaHija[]

  @@unique([categoriaId, nombre])
  @@index([categoriaId, orden])
  @@map("subcategorias")
}

// Tercer nivel de la taxonomía (Despensa → Café y Cafeteras → Café en grano).
// Es una entidad separada para que la tienda tenga exactamente tres niveles,
// cada uno ordenable y administrable sin textos fijos en el frontend.
model SubcategoriaHija {
  id             String       @id @default(uuid()) @db.Uuid
  nombre         String       @db.VarChar(100)
  slug           String       @unique @db.VarChar(160)
  subcategoriaId String       @map("subcategoria_id") @db.Uuid
  subcategoria   Subcategoria @relation(fields: [subcategoriaId], references: [id], onDelete: Cascade)
  orden          Int          @default(0)
  activa         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  productos      Producto[]

  @@unique([subcategoriaId, nombre])
  @@index([subcategoriaId, orden])
  @@map("subcategorias_hijas")
}

model Marca {
  id               String     @id @default(uuid()) @db.Uuid
  nombre           String     @unique @db.VarChar(120)
  slug             String     @unique @db.VarChar(140)
  logoUrl          String?    @map("logo_url") @db.VarChar(500)
  logoStorageKey   String?    @map("logo_storage_key") @db.VarChar(300)
  brandfetchDomain String?    @map("brandfetch_domain") @db.VarChar(253)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  productos        Producto[]

  @@map("marcas")
}

model Producto {
  id             String  @id @default(uuid()) @db.Uuid
  sku            String  @unique @db.VarChar(80)
  slug           String  @unique @db.VarChar(180)
  nombre         String  @db.VarChar(200)
  nombreBusqueda String? @map("nombre_busqueda") @db.VarChar(220)
  descripcion    String

  // CLP no usa fracciones: almacenar pesos como enteros evita errores de float.
  precio         Int
  precioAnterior Int? @map("precio_anterior")

  // Estar publicado y tener stock son estados distintos: un producto agotado
  // puede seguir visible, mientras que su estado editorial controla exposición.
  stock           Int            @default(0)
  // Unidades comprometidas por pedidos PENDIENTE aún no aceptados. El stock
  // disponible real es (stock - stockReservado): así dos pedidos no venden la
  // misma unidad mientras el dueño no confirma.
  stockReservado  Int            @default(0) @map("stock_reservado")
  estado          EstadoProducto @default(BORRADOR)
  destacado       Boolean        @default(false)
  alertaStockBajo Int?           @map("alerta_stock_bajo")

  codigoBarras       String?   @unique @map("codigo_barras") @db.VarChar(50)
  origen             String?   @db.VarChar(120)
  contenidoCantidad  Decimal?  @map("contenido_cantidad") @db.Decimal(10, 3)
  contenidoUnidad    String?   @map("contenido_unidad") @db.VarChar(20)
  pesoDespachoGramos Int?      @map("peso_despacho_gramos")
  fechaVencimiento   DateTime? @map("fecha_vencimiento") @db.Date

  categoriaId        String   @map("categoria_id") @db.Uuid
  // Subcategoría opcional: no todos los productos están clasificados a ese nivel.
  // Si se borra la subcategoría, el producto queda sin ella (SetNull), no se borra.
  subcategoriaId     String?  @map("subcategoria_id") @db.Uuid
  // El tercer nivel es opcional durante la migración: los productos ya
  // clasificados en nivel dos siguen siendo válidos hasta que se completen.
  subcategoriaHijaId String?  @map("subcategoria_hija_id") @db.Uuid
  marcaId            String?  @map("marca_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  categoria        Categoria           @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  subcategoria     Subcategoria?       @relation(fields: [subcategoriaId], references: [id], onDelete: SetNull)
  subcategoriaHija SubcategoriaHija?   @relation(fields: [subcategoriaHijaId], references: [id], onDelete: SetNull)
  marca            Marca?              @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  imagenes         ProductoImagen[]
  promociones      PromocionProducto[]
  etiquetas        ProductoEtiqueta[]
  itemsPedido      ItemPedido[]
  avisosStock      AvisoStock[]
  movimientosStock MovimientoStock[]
  atributos        ProductoAtributo[]
  favoritos        Favorito[]

  @@index([categoriaId])
  @@index([subcategoriaId])
  @@index([subcategoriaHijaId])
  @@index([marcaId])
  @@index([estado])
  @@index([destacado])
  @@map("productos")
}

// Valor elegido por producto. La restricción de que opción y atributo sean
// coherentes se valida en el servicio administrativo antes de persistir.
model ProductoAtributo {
  productoId String            @map("producto_id") @db.Uuid
  atributoId String            @map("atributo_id") @db.Uuid
  opcionId   String            @map("opcion_id") @db.Uuid
  producto   Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  atributo   AtributoCategoria @relation(fields: [atributoId], references: [id], onDelete: Cascade)
  opcion     OpcionAtributo    @relation(fields: [opcionId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now()) @map("created_at")

  @@id([productoId, atributoId])
  @@index([atributoId, opcionId])
  @@index([opcionId])
  @@map("producto_atributos")
}

// Bitácora append-only de ajustes MANUALES de stock (recepción, merma, conteo).
// No es la fuente de verdad del stock —lo sigue siendo Producto.stock— sino su
// auditoría: cada fila se inserta en la misma transacción que actualiza el stock,
// guardando el delta aplicado y el stock resultante (foto para no recalcular).
// El usuario que lo hizo queda referenciado; si se borra, el movimiento sobrevive
// sin autor (SetNull) para no perder la trazabilidad.
model MovimientoStock {
  id              String                @id @default(uuid()) @db.Uuid
  productoId      String                @map("producto_id") @db.Uuid
  usuarioId       String?               @map("usuario_id") @db.Uuid
  delta           Int
  motivo          MotivoMovimientoStock
  stockResultante Int                   @map("stock_resultante")
  nota            String?               @db.VarChar(300)
  createdAt       DateTime              @default(now()) @map("created_at")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario  Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([productoId, createdAt])
  @@index([usuarioId])
  @@map("movimientos_stock")
}

// Una promoción describe una campaña reutilizable. La relación intermedia evita
// duplicar sus fechas y porcentaje en cada producto que participa de ella.
model Promocion {
  id                  String              @id @default(uuid()) @db.Uuid
  nombre              String              @db.VarChar(120)
  slug                String              @unique @db.VarChar(140)
  porcentajeDescuento Int                 @map("porcentaje_descuento")
  empiezaEn           DateTime            @map("empieza_en")
  terminaEn           DateTime            @map("termina_en")
  activa              Boolean             @default(true)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  productos           PromocionProducto[]

  @@index([activa, empiezaEn, terminaEn])
  @@map("promociones")
}

// Un producto puede participar en distintas campañas a lo largo del tiempo.
// La clave compuesta impide repetirlo dentro de la misma promoción.
model PromocionProducto {
  promocionId String   @map("promocion_id") @db.Uuid
  productoId  String   @map("producto_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  promocion Promocion @relation(fields: [promocionId], references: [id], onDelete: Cascade)
  producto  Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@id([promocionId, productoId])
  @@index([productoId])
  @@map("promocion_productos")
}

// Las etiquetas son reutilizables; una relación evita depender de texto libre
// y permite convertirlas en filtros del catálogo cuando el producto lo requiera.
model Etiqueta {
  id        String             @id @default(uuid()) @db.Uuid
  nombre    String             @unique @db.VarChar(60)
  slug      String             @unique @db.VarChar(70)
  createdAt DateTime           @default(now()) @map("created_at")
  productos ProductoEtiqueta[]

  @@map("etiquetas")
}

model ProductoEtiqueta {
  productoId String   @map("producto_id") @db.Uuid
  etiquetaId String   @map("etiqueta_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  etiqueta Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([productoId, etiquetaId])
  @@index([etiquetaId])
  @@map("producto_etiquetas")
}

model ProductoImagen {
  id               String   @id @default(uuid()) @db.Uuid
  productoId       String   @map("producto_id") @db.Uuid
  url              String   @db.VarChar(500)
  storageKey       String?  @map("storage_key") @db.VarChar(300)
  textoAlternativo String?  @map("texto_alternativo") @db.VarChar(255)
  orden            Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  // Una galería no puede tener dos imágenes en la misma posición.
  @@unique([productoId, orden])
  @@index([productoId])
  @@map("producto_imagenes")
}

// Un pedido congela (snapshot) contacto, dirección y montos del instante de
// compra: el histórico no cambia aunque luego se editen productos o promociones.
model Pedido {
  id     String @id @default(uuid()) @db.Uuid
  // Número legible para clientes y dueño ("SE-1043"); el uuid es la llave técnica.
  numero Int    @unique @default(autoincrement())

  estado    EstadoPedido     @default(PENDIENTE)
  modalidad ModalidadEntrega

  // Dueño de la cuenta, opcional: los pedidos de invitado quedan en null. El
  // contacto sigue guardándose como snapshot (puede diferir del email de la
  // cuenta). SetNull: si se borra el cliente, su historial sobrevive sin dueño.
  clienteId String?  @map("cliente_id") @db.Uuid
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  // Contacto como snapshot (invitado o el que se escribió al comprar).
  contactoNombre   String @map("contacto_nombre") @db.VarChar(120)
  contactoEmail    String @map("contacto_email") @db.VarChar(255)
  contactoTelefono String @map("contacto_telefono") @db.VarChar(40)

  // Dirección como snapshot; solo se llena cuando la modalidad es DESPACHO.
  dirCalle         String? @map("dir_calle") @db.VarChar(200)
  dirDepto         String? @map("dir_depto") @db.VarChar(60)
  dirComuna        String? @map("dir_comuna") @db.VarChar(80)
  dirRegion        String? @map("dir_region") @db.VarChar(80)
  dirInstrucciones String? @map("dir_instrucciones") @db.VarChar(300)

  // Montos calculados en el servidor y congelados. Enteros CLP, nunca floats.
  subtotal   Int
  descuento  Int @default(0)
  costoEnvio Int @default(0) @map("costo_envio")
  total      Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items   ItemPedido[]
  eventos EventoPedido[]
  pagos   Pago[]

  @@index([estado])
  @@index([createdAt])
  @@index([clienteId])
  @@map("pedidos")
}

// Intento de pago de un pedido. 1:N: un pedido puede tener varios (uno rechazado
// y luego uno aprobado). El webhook del proveedor es la fuente de verdad del
// estado; `referenciaExterna` es el id del pago/preferencia en el proveedor, por
// donde la notificación entrante encuentra su fila de forma idempotente.
model Pago {
  id                String     @id @default(uuid()) @db.Uuid
  pedidoId          String     @map("pedido_id") @db.Uuid
  proveedor         String     @db.VarChar(40)
  referenciaExterna String?    @unique @map("referencia_externa") @db.VarChar(200)
  estado            EstadoPago @default(PENDIENTE)
  // Monto en CLP, entero (como el resto de los montos). Congelado al iniciarse.
  monto             Int
  // Carga cruda del proveedor para auditar/depurar sin perder información.
  datosProveedor    Json?      @map("datos_proveedor")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@index([estado])
  @@map("pagos")
}

// Cada línea guarda el snapshot del producto al comprar. productoId es opcional
// (SetNull) para que el pedido sobreviva si el producto se elimina, pero permite
// "Repetir pedido" mientras el producto siga existiendo.
model ItemPedido {
  id         String  @id @default(uuid()) @db.Uuid
  pedidoId   String  @map("pedido_id") @db.Uuid
  productoId String? @map("producto_id") @db.Uuid

  nombre       String @db.VarChar(200)
  sku          String @db.VarChar(80)
  precioNormal Int    @map("precio_normal")
  precioFinal  Int    @map("precio_final")
  cantidad     Int
  subtotal     Int

  pedido   Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([productoId])
  @@map("items_pedido")
}

// Una fila por cambio de estado: alimenta la línea de tiempo del detalle y deja
// trazabilidad (cuándo ocurrió y una nota opcional del operador).
model EventoPedido {
  id        String       @id @default(uuid()) @db.Uuid
  pedidoId  String       @map("pedido_id") @db.Uuid
  estado    EstadoPedido
  nota      String?      @db.VarChar(300)
  createdAt DateTime     @default(now()) @map("created_at")

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("eventos_pedido")
}

// Reglas comerciales editables por el dueño (pantalla "Reglas de la tienda").
// Fila única (patrón singleton): el id fijo garantiza que solo exista una
// configuración. Los montos son enteros CLP; el corte de retiro es "HH:MM".
model ConfiguracionTienda {
  id               String   @id @default("singleton") @db.VarChar(20)
  envioGratisDesde Int      @map("envio_gratis_desde")
  tarifaBase       Int      @map("tarifa_base")
  corteRetiroHoy   String   @map("corte_retiro_hoy") @db.VarChar(5)
  preparacionHoras Int      @map("preparacion_horas")
  // Ventana de entrega a domicilio, texto libre (ej. "Lun a Vie · 09:00 a 18:00").
  // Se muestra en el detalle del pedido; editable desde el panel de reglas.
  horarioEntrega   String   @map("horario_entrega") @db.VarChar(120)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("configuracion_tienda")
}

// Identidad de la tienda: fila única (singleton, como ConfiguracionTienda) con
// los datos de marca que hoy están hardcodeados en el front (nombre, contacto,
// dirección, horario de atención, redes). GET público la expone; el dueño la
// edita desde el panel. Campos opcionales van nullable; si no hay fila, el
// servicio cae en IDENTIDAD_POR_DEFECTO (la tienda nunca queda sin identidad).
model IdentidadTienda {
  id        String   @id @default("singleton") @db.VarChar(20)
  nombre    String   @db.VarChar(120)
  email     String   @db.VarChar(255)
  telefono  String   @db.VarChar(40)
  whatsapp  String?  @db.VarChar(40)
  direccion String   @db.VarChar(200)
  // Horario de atención ESTRUCTURADO: array de 7 días (índice 0 = lunes), cada
  // uno { abierto, apertura "HH:MM", cierre "HH:MM" }. El editor lo selecciona
  // (nada de texto libre) y el servicio deriva el texto de display al vuelo.
  horario   Json     @map("horario")
  instagram String?  @db.VarChar(255)
  facebook  String?  @db.VarChar(255)
  tiktok    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("identidad_tienda")
}

// Páginas de contenido estáticas (nosotros, términos, privacidad, faq). El slug
// es la llave pública; el cuerpo es Markdown (se renderiza saneado en el front).
// `publicada` controla si la página se expone al público: GET público la oculta
// si es false. El conjunto de slugs válidos vive en lib/paginasContenido.js.
model PaginaContenido {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(60)
  titulo    String   @db.VarChar(160)
  // Markdown; sin límite de VarChar → columna text (páginas largas).
  cuerpo    String
  publicada Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("paginas_contenido")
}

// Banners promocionales del carrusel del home. La imagen vive en Cloudinary
// (imagenUrl + storageKey para poder borrarla). `enlace` es opcional (URL externa
// o ruta interna como "/#catalogo"). `orden` decide la secuencia; `activo` y la
// vigencia (empiezaEn/terminaEn, ambas opcionales) controlan si se muestra.
model Banner {
  id         String    @id @default(uuid()) @db.Uuid
  titulo     String    @db.VarChar(160)
  imagenUrl  String    @map("imagen_url")
  storageKey String?   @map("storage_key") @db.VarChar(255)
  enlace     String?   @db.VarChar(500)
  orden      Int       @default(0)
  activo     Boolean   @default(true)
  empiezaEn  DateTime? @map("empieza_en")
  terminaEn  DateTime? @map("termina_en")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([activo, orden])
  @@map("banners")
}

// Tarifa de despacho por comuna. `comuna` es la clave normalizada (sin tildes,
// minúsculas) para buscarla desde el texto que escribe el comprador; `nombre`
// es el rótulo visible. `plazoHoras` opcional: si es null, se confirma al
// despachar.
model TarifaComuna {
  id         String   @id @default(uuid()) @db.Uuid
  comuna     String   @unique @db.VarChar(80)
  nombre     String   @db.VarChar(80)
  tarifa     Int
  plazoHoras Int?     @map("plazo_horas")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("tarifas_comuna")
}

// Cuenta de comprador. Es un dominio SEPARADO del staff (Usuario): distinta
// tabla, distintas sesiones y distinta cookie. Así un cliente nunca puede tocar
// el panel y sus datos (direcciones, historial) no ensucian al staff. Comparte
// los helpers de hash y el patrón de sesión, no la identidad.
model Cliente {
  id           String   @id @default(uuid()) @db.Uuid
  nombre       String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  // Opcional: una cuenta creada solo con Google no tiene contraseña. Con Google +
  // contraseña conviven (cuenta fusionada). Si es null, el login por contraseña
  // debe rechazarse con el mismo error genérico que credenciales inválidas.
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  // Identificador estable del usuario en Google (claim `sub` del ID token). Único
  // para que dos clientes no puedan enlazar la misma cuenta de Google.
  googleId     String?  @unique @map("google_id") @db.VarChar(255)
  telefono     String?  @db.VarChar(40)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sesiones           SesionCliente[]
  direcciones        Direccion[]
  pedidos            Pedido[]
  avisosStock        AvisoStock[]
  suscripciones      Suscriptor[]
  tokensRecuperacion TokenRecuperacion[]
  favoritos          Favorito[]

  @@index([activo])
  @@map("clientes")
}

// Direcciones guardadas del cliente (pantalla /mi-cuenta). Los campos y largos
// coinciden con el esquema de dirección del checkout. Invariante de negocio: a
// lo sumo una `predeterminada` por cliente, garantizada en el servicio con
// transacciones (no con una constraint, porque "0 o 1 default" no se expresa
// bien en SQL portable).
model Direccion {
  id             String   @id @default(uuid()) @db.Uuid
  clienteId      String   @map("cliente_id") @db.Uuid
  etiqueta       String?  @db.VarChar(60)
  calle          String   @db.VarChar(200)
  depto          String?  @db.VarChar(60)
  comuna         String   @db.VarChar(80)
  region         String   @db.VarChar(80)
  instrucciones  String?  @db.VarChar(300)
  predeterminada Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("direcciones")
}

// Igual que Sesion (staff): la base guarda solo el hash del token, nunca el
// token que viaja en la cookie. Permite expirar/revocar sin credenciales
// reutilizables.
model SesionCliente {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiraEn   DateTime  @map("expira_en")
  revocadaEn DateTime? @map("revocada_en")
  createdAt  DateTime  @default(now()) @map("created_at")
  clienteId  String    @map("cliente_id") @db.Uuid

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([expiraEn])
  @@map("sesiones_cliente")
}

// Token de recuperación de contraseña. Igual que las sesiones: la base guarda
// solo el HASH del token, nunca el token que viaja en el enlace del correo.
// Un solo uso (`usadoEn`) + vencimiento (`expiraEn`). Sirve a AMBOS dominios:
// enlaza a un Cliente O a un Usuario (exactamente uno, garantizado en el
// servicio); ambos con borrado en cascada para no dejar tokens huérfanos.
model TokenRecuperacion {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en")
  createdAt DateTime  @default(now()) @map("created_at")

  clienteId String?  @map("cliente_id") @db.Uuid
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuarioId String?  @map("usuario_id") @db.Uuid
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([usuarioId])
  @@index([expiraEn])
  @@map("tokens_recuperacion")
}

// "Avísame": un interesado deja su correo para que le avisemos cuando un
// producto agotado vuelva a tener stock. El cliente es opcional (un invitado
// también puede suscribirse). El ciclo de vida se lee por sus fechas:
//   pendiente  -> creadoEn con listoEn = null
//   listo      -> listoEn se marca cuando el stock vuelve (dispara el turno CP4)
//   notificado -> notificadoEn lo pondrá el módulo de correo al enviar
model AvisoStock {
  id           String    @id @default(uuid()) @db.Uuid
  productoId   String    @map("producto_id") @db.Uuid
  email        String    @db.VarChar(255)
  clienteId    String?   @map("cliente_id") @db.Uuid
  creadoEn     DateTime  @default(now()) @map("creado_en")
  listoEn      DateTime? @map("listo_en")
  notificadoEn DateTime? @map("notificado_en")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  cliente  Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  // Un mismo correo no se suscribe dos veces al mismo producto: si vuelve a
  // pedir aviso, se reutiliza y reactiva esa fila (lógica en el servicio).
  @@unique([productoId, email])
  @@index([productoId])
  @@index([clienteId])
  @@map("avisos_stock")
}

// Lista de deseos del cliente: un producto marcado como favorito. Distinto de
// "Avísame" (que es para agotados y admite invitados): favoritos es SIEMPRE de
// una cuenta y no depende del stock. Relación N:M cliente↔producto materializada
// como fila propia para poder ordenarla por fecha. Ambos lados en cascada: si se
// borra el cliente o el producto, la fila de favorito desaparece.
model Favorito {
  id         String   @id @default(uuid()) @db.Uuid
  clienteId  String   @map("cliente_id") @db.Uuid
  productoId String   @map("producto_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  // Un producto aparece una sola vez en la lista de un cliente.
  @@unique([clienteId, productoId])
  @@index([clienteId])
  @@index([productoId])
  @@map("favoritos")
}

// Suscripción al boletín (newsletter del footer). A diferencia de "Avísame", no
// depende de un producto: es un correo que quiere recibir ofertas. La baja se
// hace con un `token` (enlace "cancelar con un clic"), sin pedir login.
enum EstadoSuscriptor {
  ACTIVO
  BAJA
}

model Suscriptor {
  id        String           @id @default(uuid()) @db.Uuid
  email     String           @unique @db.VarChar(255)
  estado    EstadoSuscriptor @default(ACTIVO)
  token     String           @unique @default(uuid()) @db.Uuid
  clienteId String?          @map("cliente_id") @db.Uuid
  creadoEn  DateTime         @default(now()) @map("creado_en")
  bajaEn    DateTime?        @map("baja_en")

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@map("suscriptores")
}
